@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="card">
    <div class="card-body">
        <div class="page-header">
            <h1 class="page-title">DestekHub MVC Katmanı</h1>
            <p class="page-subtitle">Mevcut HTML arayüzünü bozmadan çalışan Razor görünümü.</p>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-info">
                    <div class="stat-value">JSON</div>
                    <div class="stat-label">Repository tabanlı veri katmanı</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <div class="stat-value">MVC</div>
                    <div class="stat-label">ViewModel ve Layout desteği</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-info">
                    <div class="stat-value">Auth</div>
                    <div class="stat-label">Cookie tabanlı giriş ve rol kontrolü</div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3" style="flex-wrap: wrap;">
            <a class="btn btn-primary" href="/account/login">Giriş Yap</a>
            <a class="btn btn-secondary" href="/account/register">Kayıt Ol</a>
            <a class="btn btn-outline" href="/dashboard">Paneli Aç</a>
        </div>
    </div>
</section>
